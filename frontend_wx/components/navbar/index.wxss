.nav-bar-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 9999;
  display: flex;
  flex-direction: column;
}

.title-bar {
  width: 100%;
  display: flex;
  align-items: center;
  position: relative;
}

/* 标题承载底色/毛玻璃 */
.title-container {
  margin-left: 20rpx;
  display: flex;
  align-items: center;
  position: relative;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  overflow: hidden;
  transition: all 0.3s ease;
}

.title-container.glass-plate {
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 微光效果 */
.shimmer-effect {
  position: absolute;
  top: 0;
  left: -150%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to right,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.4) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: skewX(-25deg);
  animation: shimmer 4s infinite;
  z-index: 0;
}

@keyframes shimmer {
  0% { left: -150%; }
  30% { left: 150%; }
  100% { left: 150%; }
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  height: 72rpx;
  width: 72rpx;
  background: rgba(255, 255, 255, 0.5) !important;
  backdrop-filter: blur(10px) !important;
  -webkit-backdrop-filter: blur(10px) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.8) !important;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s;
}

.back-btn:active {
  transform: scale(0.9);
}

.back-icon {
  width: 28rpx;
  height: 28rpx;
  -webkit-mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><path d="M685.248 104.704a64 64 0 0 1 0 90.496L363.744 512l321.504 316.8a64 64 0 0 1-90.496 90.496l-366.752-362.048a64 64 0 0 1 0-90.496l366.752-362.048a64 64 0 0 1 90.496 0z"/></svg>') no-repeat;
  -webkit-mask-size: 100% 100%;
  mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><path d="M685.248 104.704a64 64 0 0 1 0 90.496L363.744 512l321.504 316.8a64 64 0 0 1-90.496 90.496l-366.752-362.048a64 64 0 0 1 0-90.496l366.752-362.048a64 64 0 0 1 90.496 0z"/></svg>') no-repeat;
  mask-size: 100% 100%;
  background-color: currentColor;
}

.title-text {
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 1px;
  z-index: 1;
  position: relative;
}
