/*
  主题色
  BLACK   #333333
  GRAY   #969799
  lightgray #f1f6f7 ｜ #e5eaeb

  ASH BLUE  #0073f4
  DOVE GREY   #9C8F96
  DANDELION  #EBC57C
  BLUE SLATE   #6B799E
*/

.customContainer {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  color: #333333;
  overflow: auto;
}
.customContent {
  width: 100%;
  padding: 0rpx 36rpx 60rpx 36rpx;
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.customFooter {
  display: flex;
  width: 100%;
  padding-bottom: env(safe-area-inset-bottom);
}
.noData{
  padding: 60rpx;
  width: 100%;
  text-align: center;
  color: #A3A6AD;
  font-size: 34rpx;
}


.primaryButton{
  background: linear-gradient(270deg, #0073f4 0%, #0073f4 100%);
  border-radius: 60rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 60rpx;
  white-space: nowrap;
}
.plainPrimaryButton {
  background: white;
  border-radius: 60rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #0073f4;
  border: 2rpx solid #0073f4;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 60rpx;
  white-space: nowrap;
}

/* 弹出框 */
.require {
  position: relative;
  /* padding-left: 30rpx; */
}
.require::before {
  content: '*';
  font-size: 36rpx;
  color: red;
  position: absolute;
  top: 0;
  bottom: 0;
  right: -10rpx;
  margin: auto;
  display: flex;
  align-items: center;
}

.oneLine {
  overflow: hidden;
  white-space:nowrap;
  text-overflow:ellipsis;
}

view,scroll-view {
  /* letter-spacing: 1px; */
  box-sizing: border-box;
}
/* button {
  margin: 0 !important;
  width: auto !important;
  padding: 0 !important;
  background: transparent !important;
} */
::-webkit-scrollbar { display: none; width: 0; height: 0; color: transparent; }

/* ---------------- 底部操作栏 - 毛玻璃悬浮药丸 (全局) ---------------- */
.bottom-sticky-bar {
  position: fixed;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  left: 40rpx;
  right: 40rpx;
  padding: 0;
  z-index: 100;
}

.button-group {
  display: flex;
  gap: 20rpx;
}

.secondary-btn {
  width: 200rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.primary-btn {
  flex: 1;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #333;
  font-weight: 700;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.1);
}

.primary-btn:active, .secondary-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
  transition: all 0.2s;
}

/* 辅助 */
.safe-bottom-holder {
  height: calc(240rpx + env(safe-area-inset-bottom));
}
